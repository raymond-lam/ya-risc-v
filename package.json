{
  "name": "ya-risc-v",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#emulator/cpu/run": {
      "@ya-risc-v/source": "./src/emulator/cpu/run.ts",
      "default": "./dist/emulator/cpu/run.js"
    },
    "#emulator/terminal/run": {
      "@ya-risc-v/source": "./src/emulator/terminal/run.ts",
      "default": "./dist/emulator/terminal/run.js"
    }
  },
  "bin": {
    "ya-risc-v": "./dist/index.js"
  },
  "scripts": {
    "build": "rimraf dist && esbuild src/index.ts src/emulator/cpu/run.ts src/emulator/terminal/run.ts --bundle --platform=node --format=esm --packages=external --external:#emulator/cpu/run --external:#emulator/terminal/run --jsx=automatic --outdir=dist --outbase=src",
    "start": "node dist/index.js",
    "dev": "tsx --conditions @ya-risc-v/source src/index.ts",
    "test": "tsx --conditions @ya-risc-v/source --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run type-check && npm test",
    "fix": "npm run format && npm run lint:fix"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^1.0.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  }
}
